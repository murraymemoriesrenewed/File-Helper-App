# Copy to .env and fill in. Keep .env private.

# Secret NocoBase must send in the X-Api-Key header. Make it long and random,
# e.g. in PowerShell:  -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 40 | % {[char]$_})
HELPER_API_KEY=

# The network share behind Z:\ in forward-slash form. Find it with:  net use
#   \\SERVER\Projects   ->   //SERVER/Projects
# Use only //SERVER/ShareName here, and put any folder below it in SHARE_SUBDIR.
#   Z: = \\192.168.1.10\Users\Murray Levitt  ->  SHARE_UNC=//192.168.1.10/Users
#                                                SHARE_SUBDIR=Murray Levitt
SHARE_UNC=//SERVER/Projects
SHARE_SUBDIR=
# A Windows/NAS account that can read and write the share
# (avoid commas in the password - they break the mount options)
SHARE_USER=
SHARE_PASSWORD=
# WORKGROUP for most home/small-office setups; the PC name for a local account on that PC
SHARE_DOMAIN=WORKGROUP
# Use 2.1 or 2.0 if the server is old and 3.0 fails to mount
SMB_VERSION=3.0

# How paths are shown back to NocoBase
DISPLAY_ROOT=Z:\
TIMEZONE=America/Chicago
HELPER_PORT=8765
